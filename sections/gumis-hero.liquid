{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.hero.heading_html' | t
  endif
  assign subheading = section.settings.subheading
  if subheading == blank
    assign subheading = 'gumis.hero.subheading' | t
  endif
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'gumis.hero.eyebrow' | t
  endif
  assign cta1_label = section.settings.cta1_label
  if cta1_label == blank
    assign cta1_label = 'gumis.hero.cta_primary' | t
  endif
  assign cta1_link = section.settings.cta1_link | default: routes.all_products_collection_url
  assign cta2_label = section.settings.cta2_label
  if cta2_label == blank
    assign cta2_label = 'gumis.hero.cta_secondary' | t
  endif
  assign cta2_link = section.settings.cta2_link | default: '#gumis-why'

  assign hero_image = section.settings.image
  if hero_image == blank and section.settings.product != blank
    assign hero_image = section.settings.product.featured_media
  endif
  assign jar_name = 'gumis.placeholders.product_sleep' | t
-%}
<section
  id="{{ section.settings.anchor | default: 'gumis-hero' | handleize }}"
  class="g-hero"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container g-hero__grid">
    <div class="g-hero__copy">
      <p class="g-eyebrow">{{ eyebrow | escape }}</p>
      <h1 class="g-hero__title">{{ heading }}</h1>
      <p class="g-hero__lede">{{ subheading }}</p>
      <div class="g-hero__ctas">
        <a href="{{ cta1_link }}" class="g-btn g-btn--primary">{{ cta1_label | escape }}</a>
        <a href="{{ cta2_link }}" class="g-btn g-btn--ghost">{{ cta2_label | escape }}</a>
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="g-ticks" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{%- render 'gumis-icon', icon: 'check' -%}<span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="g-hero__media">
      <span class="g-halo" aria-hidden="true"></span>
      {%- if hero_image != blank -%}
        {{
          hero_image
          | image_url: width: 1400
          | image_tag:
            widths: '400, 600, 800, 1000, 1200, 1400',
            sizes: '(min-width: 1000px) 560px, 92vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'g-hero__image'
        }}
      {%- else -%}
        {%- render 'gumis-blobs', preset: 'hero' -%}
        {%- render 'gumis-jar', accent: settings.gumis_berry, name: jar_name, show_count: true, pedestal: true, class: 'g-hero__jar' -%}
      {%- endif -%}
      {%- if section.settings.chip_1 != blank -%}
        <span class="g-chip g-chip--a" aria-hidden="true"><i style="background: var(--gumis-tangerine);"></i>{{ section.settings.chip_1 | escape }}</span>
      {%- endif -%}
      {%- if section.settings.chip_2 != blank -%}
        <span class="g-chip g-chip--b" aria-hidden="true"><i style="background: var(--gumis-berry);"></i>{{ section.settings.chip_2 | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gumis Hero",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Laissez un texte vide pour afficher la traduction par défaut (FR/EN). Mettez un mot en italique dans le titre pour le colorer en Berry." },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre" },
    { "type": "inline_richtext", "id": "subheading", "label": "Sous-titre" },
    { "type": "header", "content": "Boutons" },
    { "type": "text", "id": "cta1_label", "label": "Bouton 1 — texte" },
    { "type": "url", "id": "cta1_link", "label": "Bouton 1 — lien", "info": "Vide = tous les produits." },
    { "type": "text", "id": "cta2_label", "label": "Bouton 2 — texte" },
    { "type": "url", "id": "cta2_link", "label": "Bouton 2 — lien", "info": "Vide = section « Pourquoi des gummies ? »." },
    { "type": "header", "content": "Visuel" },
    { "type": "image_picker", "id": "image", "label": "Image produit", "info": "PNG détouré conseillé. Sans image, un pot dessiné est affiché." },
    { "type": "product", "id": "product", "label": "Ou image principale d'un produit" },
    { "type": "text", "id": "chip_1", "label": "Étiquette flottante 1", "default": "Pot de 60 gummies" },
    { "type": "text", "id": "chip_2", "label": "Étiquette flottante 2", "default": "À croquer, sans eau" },
    { "type": "header", "content": "Mise en page" },
    { "type": "text", "id": "anchor", "label": "Ancre (id)", "default": "gumis-hero" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 136 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Argument",
      "limit": 4,
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Texte", "default": "Pot de 60 gummies" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis Hero",
      "blocks": [
        { "type": "point", "settings": { "text": "3 formules" } },
        { "type": "point", "settings": { "text": "Paiement sécurisé" } }
      ]
    }
  ]
}
{% endschema %}
