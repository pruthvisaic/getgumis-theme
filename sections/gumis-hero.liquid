{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.hero.heading' | t
  endif
  assign subheading = section.settings.subheading
  if subheading == blank
    assign subheading = 'gumis.hero.subheading' | t
  endif
  assign eyebrow = section.settings.eyebrow | default: settings.gumis_tagline
  if eyebrow == blank
    assign eyebrow = 'gumis.brand.tagline' | t
  endif
  assign cta1_label = section.settings.cta1_label
  if cta1_label == blank
    assign cta1_label = 'gumis.hero.cta_primary' | t
  endif
  assign cta1_link = section.settings.cta1_link | default: routes.all_products_collection_url
  assign cta2_label = section.settings.cta2_label
  if cta2_label == blank
    assign cta2_label = 'gumis.hero.cta_secondary' | t
  endif
  assign cta2_link = section.settings.cta2_link | default: '#gumis-why'

  assign hero_image = section.settings.image
  if hero_image == blank and section.settings.product != blank
    assign hero_image = section.settings.product.featured_media
  endif
-%}
<section
  id="{{ section.settings.anchor | default: 'gumis-hero' | handleize }}"
  class="gumis-section gumis-hero color-{{ section.settings.color_scheme }} gradient"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  {%- if section.settings.show_blobs -%}
    {%- render 'gumis-blobs', preset: 'hero' -%}
  {%- endif -%}
  <div class="page-width gumis-hero__grid gumis-relative">
    <div class="gumis-hero__content">
      {%- if eyebrow != blank -%}
        <p class="gumis-eyebrow">{{ eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="gumis-hero__heading h0">{{ heading }}</h1>
      <p class="gumis-hero__sub">{{ subheading }}</p>
      <div class="gumis-button-row">
        <a href="{{ cta1_link }}" class="button button--primary button--large">
          {{- cta1_label | escape -}}
          {%- render 'gumis-icon', icon: 'arrow-right' -%}
        </a>
        <a href="{{ cta2_link }}" class="button button--secondary button--large">{{ cta2_label | escape }}</a>
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="gumis-hero__points list-unstyled" role="list">
          {%- for block in section.blocks -%}
            <li class="gumis-hero__point" {{ block.shopify_attributes }}>
              {%- render 'gumis-icon', icon: block.settings.icon -%}
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="gumis-hero__media">
      <div class="gumis-hero__media-inner">
        {%- if hero_image != blank -%}
          {{
            hero_image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: '(min-width: 990px) 560px, 92vw',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'gumis-hero__image'
          }}
        {%- else -%}
          <div class="gumis-hero__jars">
            {%- render 'gumis-jar', accent: settings.gumis_plum, ink: '#FFFFFF', label: 'Sommeil', class: 'gumis-jar--left' -%}
            {%- render 'gumis-jar', accent: settings.gumis_berry, ink: '#FFFFFF', label: 'Éclat', class: 'gumis-jar--center' -%}
            {%- render 'gumis-jar', accent: settings.gumis_tangerine, ink: settings.gumis_plum, label: 'Force', class: 'gumis-jar--right' -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gumis Hero",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Laissez un texte vide pour afficher la traduction par défaut (FR/EN)." },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "info": "Vide = tagline de la marque." },
    { "type": "inline_richtext", "id": "heading", "label": "Titre" },
    { "type": "inline_richtext", "id": "subheading", "label": "Sous-titre" },
    { "type": "header", "content": "Boutons" },
    { "type": "text", "id": "cta1_label", "label": "Bouton 1 — texte" },
    { "type": "url", "id": "cta1_link", "label": "Bouton 1 — lien", "info": "Vide = tous les produits." },
    { "type": "text", "id": "cta2_label", "label": "Bouton 2 — texte" },
    { "type": "url", "id": "cta2_link", "label": "Bouton 2 — lien", "info": "Vide = section « Pourquoi des gummies ? »." },
    { "type": "header", "content": "Visuel" },
    { "type": "image_picker", "id": "image", "label": "Image produit" },
    { "type": "product", "id": "product", "label": "Ou image principale d'un produit" },
    { "type": "checkbox", "id": "show_blobs", "label": "Formes décoratives", "default": true },
    { "type": "header", "content": "Mise en page" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette", "default": "scheme-2" },
    { "type": "text", "id": "anchor", "label": "Ancre (id)", "default": "gumis-hero" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Argument",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "check",
          "options": [
            { "value": "check", "label": "Coche" },
            { "value": "gummy", "label": "Gummy" },
            { "value": "jar", "label": "Pot" },
            { "value": "truck", "label": "Livraison" },
            { "value": "lock", "label": "Paiement" },
            { "value": "leaf", "label": "Feuille" },
            { "value": "smile", "label": "Sourire" }
          ]
        },
        { "type": "inline_richtext", "id": "text", "label": "Texte", "default": "Pot de 60 gummies" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis Hero",
      "blocks": [
        { "type": "point", "settings": { "icon": "jar", "text": "Pot de 60 gummies" } },
        { "type": "point", "settings": { "icon": "lock", "text": "Paiement sécurisé" } }
      ]
    }
  ]
}
{% endschema %}
