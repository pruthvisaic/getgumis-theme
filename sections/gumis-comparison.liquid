{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.why.compare_heading' | t
  endif
  assign col_a = section.settings.col_gummies
  if col_a == blank
    assign col_a = 'gumis.why.col_gummies' | t
  endif
  assign col_b = section.settings.col_capsules
  if col_b == blank
    assign col_b = 'gumis.why.col_capsules' | t
  endif
-%}
<section
  id="{{ section.settings.anchor | default: 'gumis-compare' | handleize }}"
  class="g-section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container">
    <div class="g-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ heading }}</h2>
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="g-compare-wrap">
        <table class="g-compare">
          <caption class="visually-hidden">{{ heading | strip_html }}</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">{{ 'gumis.why.criterion' | t }}</span></th>
              <th scope="col" class="g-us">{{ col_a | escape }}</th>
              <th scope="col">{{ col_b | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.criterion }}</th>
                <td class="g-us">
                  {%- if block.settings.gummies_icon == 'check' -%}{%- render 'gumis-icon', icon: 'check' -%}{%- endif -%}
                  {{ block.settings.gummies }}
                </td>
                <td>{{ block.settings.capsules }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}
    {%- if section.settings.footnote != blank -%}
      <div class="g-fine-print rte">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gumis Gummies vs capsules",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Compare"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = default translation."
    },
    {
      "type": "text",
      "id": "col_gummies",
      "label": "Column 1",
      "info": "Empty = \"gumis gummies\""
    },
    {
      "type": "text",
      "id": "col_capsules",
      "label": "Column 2",
      "info": "Empty = \"Classic capsules\""
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor (id)",
      "default": "gumis-compare"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "limit": 8,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "criterion",
          "label": "Criterion",
          "default": "Criterion"
        },
        {
          "type": "inline_richtext",
          "id": "gummies",
          "label": "Gummies",
          "default": "[TO COMPLETE]"
        },
        {
          "type": "select",
          "id": "gummies_icon",
          "label": "Gummies icon",
          "default": "check",
          "options": [
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "none",
              "label": "None"
            }
          ]
        },
        {
          "type": "inline_richtext",
          "id": "capsules",
          "label": "Capsules",
          "default": "[TO COMPLETE]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis Gummies vs capsules",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "criterion": "How you take them",
            "gummies": "Chewable, no water needed",
            "capsules": "Swallowed with a glass of water"
          }
        }
      ]
    }
  ]
}
{% endschema %}
