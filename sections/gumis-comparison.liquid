{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.why.compare_heading' | t
  endif
  assign col_a = section.settings.col_gummies
  if col_a == blank
    assign col_a = 'gumis.why.col_gummies' | t
  endif
  assign col_b = section.settings.col_capsules
  if col_b == blank
    assign col_b = 'gumis.why.col_capsules' | t
  endif
-%}
<section
  id="{{ section.settings.anchor | default: 'gumis-compare' | handleize }}"
  class="g-section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container">
    <div class="g-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ heading }}</h2>
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="g-compare-wrap">
        <table class="g-compare">
          <caption class="visually-hidden">{{ heading | strip_html }}</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">{{ 'gumis.why.criterion' | t }}</span></th>
              <th scope="col" class="g-us">{{ col_a | escape }}</th>
              <th scope="col">{{ col_b | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.criterion }}</th>
                <td class="g-us">
                  {%- if block.settings.gummies_icon == 'check' -%}{%- render 'gumis-icon', icon: 'check' -%}{%- endif -%}
                  {{ block.settings.gummies }}
                </td>
                <td>{{ block.settings.capsules }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}
    {%- if section.settings.footnote != blank -%}
      <div class="g-fine-print rte">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gumis Gummies vs gélules",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Comparer" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "info": "Vide = traduction par défaut." },
    { "type": "text", "id": "col_gummies", "label": "Colonne 1", "info": "Vide = « Gummies gumis »" },
    { "type": "text", "id": "col_capsules", "label": "Colonne 2", "info": "Vide = « Gélules classiques »" },
    { "type": "richtext", "id": "footnote", "label": "Note de bas de section" },
    { "type": "text", "id": "anchor", "label": "Ancre (id)", "default": "gumis-compare" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "limit": 8,
      "settings": [
        { "type": "inline_richtext", "id": "criterion", "label": "Critère", "default": "Critère" },
        { "type": "inline_richtext", "id": "gummies", "label": "Gummies", "default": "[À COMPLÉTER]" },
        {
          "type": "select", "id": "gummies_icon", "label": "Icône gummies", "default": "check",
          "options": [ { "value": "check", "label": "Coche" }, { "value": "none", "label": "Aucune" } ]
        },
        { "type": "inline_richtext", "id": "capsules", "label": "Gélules", "default": "[À COMPLÉTER]" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis Gummies vs gélules",
      "blocks": [
        { "type": "row", "settings": { "criterion": "Comment on les prend", "gummies": "À croquer, sans eau", "capsules": "À avaler avec un verre d'eau" } }
      ]
    }
  ]
}
{% endschema %}
