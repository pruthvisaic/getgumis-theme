{%- liquid
  assign ph_sleep = 'gumis.placeholders.product_sleep' | t
  assign ph_glow = 'gumis.placeholders.product_glow' | t
  assign ph_power = 'gumis.placeholders.product_power' | t
-%}
{%- liquid
  if section.settings.use_collection_title
    assign heading = collection.title | escape
  else
    assign heading = section.settings.heading
    if heading == blank
      assign heading = 'gumis.collection.heading' | t
    endif
  endif
-%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<section
  class="g-section g-collection"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container">
    <header class="g-collection__header">
      <p class="g-eyebrow">{{ 'gumis.collection.eyebrow' | t }}</p>
      <h1>{{ heading }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="rte">{{ collection.description }}</div>
      {%- elsif section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    {%- paginate collection.products by section.settings.per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="g-grid" role="list">
          {%- for product in collection.products -%}
            <li>
              {%- liquid
                assign lazy = true
                if forloop.index <= 2
                  assign lazy = false
                endif
              -%}
              {%- assign tile_i = forloop.index0 | modulo: 3 -%}
              {%- assign tile = 'blush,peach,lilac' | split: ',' -%}
              {%- render 'gumis-product-card', product: product, section_id: section.id, heading_tag: 'h2', lazy: lazy, tile: tile[tile_i] -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if paginate.pages > 1 -%}
          {%- render 'pagination', paginate: paginate, anchor: '' -%}
        {%- endif -%}
      {%- else -%}
        <ul class="g-grid" role="list">
          <li>{%- render 'gumis-product-card', placeholder_title: ph_sleep, accent: settings.gumis_plum, section_id: section.id, heading_tag: 'h2' -%}</li>
          <li>{%- render 'gumis-product-card', placeholder_title: ph_glow, accent: settings.gumis_berry, section_id: section.id, heading_tag: 'h2', tile: 'peach' -%}</li>
          <li>{%- render 'gumis-product-card', placeholder_title: ph_power, accent: settings.gumis_tangerine, section_id: section.id, heading_tag: 'h2', tile: 'lilac' -%}</li>
        </ul>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Gumis Collection",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_collection_title",
      "label": "Use the collection title",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = \"All our gummies\""
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show the collection description",
      "default": true
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ]
}
{% endschema %}
