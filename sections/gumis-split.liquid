{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.why.heading' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'gumis.why.subheading' | t
  endif
  assign jar_name = 'gumis.placeholders.product_glow' | t
-%}
<section
  id="{{ section.settings.anchor | default: 'gumis-why' | handleize }}"
  class="g-section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container g-split{% if section.settings.media_right %} g-split--reverse{% endif %}">
    <div class="g-split__media">
      <span class="g-halo g-halo--peach" aria-hidden="true"></span>
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 1000px) 560px, 92vw', loading: 'lazy', class: 'g-split__image'
        }}
      {%- else -%}
        {%- render 'gumis-jar', accent: settings.gumis_berry, name: jar_name, class: 'g-split__jar' -%}
        {%- render 'gumis-blobs', preset: 'spill' -%}
      {%- endif -%}
    </div>
    <div class="g-split__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2>{{ heading }}</h2>
      <p class="g-split__text">{{ text }}</p>
      {%- if section.blocks.size > 0 -%}
        <ol class="g-numbered">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div></li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gumis Image with text",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why gummies"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = \"Why gummies?\""
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "info": "Empty = default translation."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Without an image, a drawn jar is shown."
    },
    {
      "type": "checkbox",
      "id": "media_right",
      "label": "Image on the right",
      "default": false
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor (id)",
      "default": "gumis-why"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "limit": 5,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "[TO COMPLETE]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis Image with text"
    }
  ]
}
{% endschema %}
