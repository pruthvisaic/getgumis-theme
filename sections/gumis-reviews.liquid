{%- comment -%}
  Reviews come ONLY from a reviews app (Judge.me, Okendo, Shopify Product Reviews...)
  added as an app block. Without an app block nothing is rendered. If the app block renders
  no reviews, the section hides itself (CSS :has + small script fallback).
  Never add fake reviews, ratings or customer counts here.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {%- liquid
    assign heading = section.settings.heading
    if heading == blank
      assign heading = 'gumis.reviews.heading' | t
    endif
  -%}
  <section
    id="{{ section.settings.anchor | default: 'gumis-reviews' | handleize }}"
    class="g-section gumis-reviews"
    style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
    data-gumis-reviews
  >
    <div class="g-container">
      <div class="g-head"><div><p class="g-eyebrow">{{ 'gumis.reviews.eyebrow' | t }}</p><h2>{{ heading }}</h2></div></div>
      <div class="gumis-reviews__apps">
        {%- for block in section.blocks -%}
          <div class="gumis-reviews__app" {{ block.shopify_attributes }}>
            {%- render block -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  <script>
    (() => {
      const section = document.currentScript.previousElementSibling;
      if (!section || window.Shopify?.designMode) return;
      const check = () => {
        const apps = section.querySelector('.gumis-reviews__apps');
        if (apps && apps.innerText.trim() === '' && !apps.querySelector('img, iframe, [data-reviews]')) section.hidden = true;
      };
      window.addEventListener('load', () => setTimeout(check, 2500), { once: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Gumis Reviews",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add the block from your reviews app (Judge.me, Okendo, Shopify Product Reviews…). Without an app block, or without reviews, the section stays hidden. Never add made-up reviews."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = \"They tasted it\""
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor (id)",
      "default": "gumis-reviews"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Gumis Reviews"
    }
  ]
}
{% endschema %}
