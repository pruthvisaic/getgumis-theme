{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.faq.heading' | t
  endif
-%}
<section
  id="{{ section.settings.anchor | default: 'gumis-faq' | handleize }}"
  class="g-section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container g-faq">
    <div class="g-faq__aside">
      {%- if section.settings.eyebrow != blank -%}<p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.contact_label != blank -%}
        <a href="{{ section.settings.contact_link | default: '/pages/contact' }}" class="g-btn g-btn--outline g-btn--sm">
          {{- section.settings.contact_label | escape -}}
        </a>
      {%- endif -%}
    </div>
    <div class="g-accordion">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }} {% if forloop.first and section.settings.open_first %}open{% endif %}>
          <summary><h3>{{ block.settings.question }}</h3></summary>
          <div class="g-accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.schema_markup and section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Gumis FAQ",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "FAQ" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "info": "Vide = « Vos questions, nos réponses »" },
    { "type": "inline_richtext", "id": "subheading", "label": "Sous-titre" },
    { "type": "text", "id": "contact_label", "label": "Bouton contact — texte" },
    { "type": "url", "id": "contact_link", "label": "Bouton contact — lien" },
    { "type": "checkbox", "id": "open_first", "label": "Ouvrir la première question", "default": false },
    { "type": "checkbox", "id": "schema_markup", "label": "Données structurées FAQ (SEO)", "default": true, "info": "N'activez qu'une seule section FAQ par page." },
    { "type": "text", "id": "anchor", "label": "Ancre (id)", "default": "gumis-faq" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "inline_richtext", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>[À COMPLÉTER]</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Combien de gummies par jour ?", "answer": "<p>Cela dépend de la formule : la dose journalière recommandée est indiquée sur chaque fiche produit et sur le pot. Ne la dépassez pas.</p>" } }
      ]
    }
  ]
}
{% endschema %}
