{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.faq.heading' | t
  endif
-%}
<section
  id="{{ section.settings.anchor | default: 'gumis-faq' | handleize }}"
  class="g-section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container g-faq">
    <div class="g-faq__aside">
      {%- if section.settings.eyebrow != blank -%}<p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.contact_label != blank -%}
        <a href="{{ section.settings.contact_link | default: '/pages/contact' }}" class="g-btn g-btn--outline g-btn--sm">
          {{- section.settings.contact_label | escape -}}
        </a>
      {%- endif -%}
    </div>
    <div class="g-accordion">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }} {% if forloop.first and section.settings.open_first %}open{% endif %}>
          <summary><h3>{{ block.settings.question }}</h3></summary>
          <div class="g-accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.schema_markup and section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Gumis FAQ",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = \"Your questions, answered\""
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact button label"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact button link"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "schema_markup",
      "label": "FAQ structured data (SEO)",
      "default": true,
      "info": "Turn this on for only one FAQ section per page."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor (id)",
      "default": "gumis-faq"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>[TO COMPLETE]</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How many gummies a day?",
            "answer": "<p>It depends on the formula: the recommended daily dose is shown on each product page and on the jar. Don't go over it.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
