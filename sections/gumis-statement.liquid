{%- liquid
  assign lead = section.settings.lead
  if lead == blank
    assign lead = 'gumis.statement.lead_html' | t
  endif
-%}
<section class="g-statement" aria-label="{{ 'gumis.statement.label' | t }}">
  <div class="g-container g-statement__grid">
    <p class="g-statement__lead">{{ lead }}</p>
    {%- if section.blocks.size > 0 -%}
      <dl class="g-stats">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}><dt>{{ block.settings.value | escape }}</dt><dd>{{ block.settings.label | escape }}</dd></div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gumis Stats band",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "lead",
      "label": "Statement",
      "info": "Empty = default translation."
    },
    {
      "type": "paragraph",
      "content": "Only show true, verifiable figures (no customer counts or made-up statistics)."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Figure",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Figure",
          "default": "60"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Caption",
          "default": "gummies per jar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis Stats band",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "3",
            "label": "formulas"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "60",
            "label": "gummies per jar"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "14",
            "label": "days to change your mind"
          }
        }
      ]
    }
  ]
}
{% endschema %}
