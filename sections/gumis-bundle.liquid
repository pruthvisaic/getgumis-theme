{%- liquid
  assign product = section.settings.product
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.bundle.heading' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'gumis.bundle.text' | t
  endif
  assign accent = section.settings.accent
  if accent == blank and product != blank
    assign accent = product.metafields.custom.accent_color.value
  endif
  if accent == blank or accent == 'rgba(0,0,0,0)'
    assign accent = settings.gumis_berry
  endif
  assign form_id = 'gumis-bundle-form-' | append: section.id
-%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gumis-quantity-breaks.js' | asset_url }}" defer="defer"></script>
<section
  id="{{ section.settings.anchor | default: 'gumis-bundle' | handleize }}"
  class="g-section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container g-split">
    <div class="g-split__media g-tile--lilac g-bundle__media">
      <span class="g-floor"></span>
      <div class="g-bottle-stack">
        {%- if product != blank and product.featured_media != blank -%}
          {%- for i in (1..3) -%}
            {%- liquid
              assign img_sizes = '(min-width: 1000px) 200px, 30vw'
              if i == 2
                assign img_sizes = '(min-width: 1000px) 240px, 36vw'
              endif
              assign img_alt = ''
              if i == 2
                assign img_alt = product.featured_media.alt | default: product.title
              endif
            -%}
            {{
              product.featured_media
              | image_url: width: 600
              | image_tag: widths: '200, 300, 400, 600', sizes: img_sizes, loading: 'lazy', alt: img_alt, class: 'g-bottle'
            }}
          {%- endfor -%}
        {%- else -%}
          {%- assign bottle = section.settings.bottle | default: 'sleep' -%}
          {%- render 'gumis-bottle', name: bottle, sizes: '(min-width: 1000px) 200px, 30vw' -%}
          {%- render 'gumis-bottle', name: bottle, sizes: '(min-width: 1000px) 240px, 36vw' -%}
          {%- render 'gumis-bottle', name: bottle, sizes: '(min-width: 1000px) 200px, 30vw' -%}
        {%- endif -%}
      </div>
    </div>

    <div class="g-split__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ heading }}</h2>
      <p class="g-split__text">{{ text }}</p>

      {%- if product != blank -%}
        <p class="g-bundle__product">{{ product.title | escape }}</p>
        {%- render 'gumis-quantity-breaks',
          product: product,
          form_id: form_id,
          accent: accent,
          default_quantity: section.settings.default_quantity
        -%}
        {%- assign variant = product.selected_or_first_available_variant -%}
        <product-form class="g-bundle__form" data-section-id="{{ section.id }}">
          {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" value="{{ variant.id }}" class="product-variant-id">
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>
            <button
              type="submit"
              name="add"
              class="g-btn g-btn--primary g-btn--block"
              {% unless variant.available %}
                disabled
              {% endunless %}
            >
              <span>
                {%- if variant.available -%}
                  {{ 'gumis.product.add_to_cart' | t }} ·
                  <span data-gumis-total-for="{{ form_id }}">{{ variant.price | money }}</span>
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
              {%- render 'loading-spinner' -%}
            </button>
          {%- endform -%}
        </product-form>
        <p class="g-fine-print g-fine-print--left">{{ 'gumis.product.tax_included' | t }}</p>
      {%- else -%}
        <p><span class="gumis-placeholder-text">{{ 'gumis.bundle.select_product' | t }}</span></p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gumis Multi-jar offer",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "select",
      "id": "bottle",
      "label": "Bottle photo without product image",
      "options": [
        { "value": "", "label": "Sleep (default)" },
                { "value": "glow", "label": "Glow" },
        { "value": "power", "label": "Power" }
      ],
      "default": ""
    },
    {
      "type": "paragraph",
      "content": "The savings shown come from the percentages in Theme settings > Gumis: cart & offers, which must match your Shopify automatic discounts."
    },
    {
      "type": "range",
      "id": "default_quantity",
      "label": "Preselected quantity",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = default translation."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "info": "Empty = default translation."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent colour",
      "info": "Empty = product's custom.accent_color metafield."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor (id)",
      "default": "gumis-bundle"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Gumis Multi-jar offer"
    }
  ]
}
{% endschema %}
