{%- liquid
  assign ph_glow = 'gumis.placeholders.product_glow' | t
  assign ph_power = 'gumis.placeholders.product_power' | t
-%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.cross_sell.heading' | t
  endif

  assign source = section.settings.products
  if source == blank and section.settings.collection != blank
    assign source = section.settings.collection.products
  endif
  if source == blank
    assign source = collections.all.products
  endif

  assign shown = 0
  assign max = section.settings.limit
-%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<section
  class="g-section gumis-cross-sell"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container">
    <div class="g-head">
      <div>
        <p class="g-eyebrow">{{ 'gumis.cross_sell.eyebrow' | t }}</p>
        <h2>{{ heading }}</h2>
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="g-text-link">{{ 'gumis.trio.view_all' | t }}</a>
    </div>
    <ul class="g-grid g-grid--swipe" role="list">
      {%- for item in source -%}
        {%- if item.id != product.id and shown < max -%}
          {%- assign shown = shown | plus: 1 -%}
          <li>
            {%- assign tiles = 'blush,peach,lilac' | split: ',' -%}
            {%- assign ti = shown | minus: 1 | modulo: 3 -%}
            {%- assign tile = tiles[ti] -%}
            {%- render 'gumis-product-card', product: item, section_id: section.id, tile: tile -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
      {%- if shown == 0 and request.design_mode -%}
        <li>{%- render 'gumis-product-card', placeholder_title: ph_glow, accent: settings.gumis_berry, section_id: section.id, tile: 'peach' -%}</li>
        <li>{%- render 'gumis-product-card', placeholder_title: ph_power, accent: settings.gumis_tangerine, section_id: section.id, tile: 'lilac' -%}</li>
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Gumis Cross-sell",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the other products (the product being viewed is left out automatically)."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = \"Complete your routine\""
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 4
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Or collection",
      "info": "Used when no product is selected. Otherwise: all products."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Gumis Cross-sell"
    }
  ]
}
{% endschema %}
