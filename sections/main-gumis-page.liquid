{%- liquid
  assign is_legal = false
  if section.settings.style == 'legal'
    assign is_legal = true
  endif
-%}
<section
  class="gumis-section gumis-page-section color-{{ section.settings.color_scheme }} gradient{% if is_legal %} gumis-page-section--legal{% endif %}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container">
    <div class="gumis-page">
      <header class="gumis-page__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="gumis-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="gumis-page__title">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- else -%}
            {{ page.title | escape }}
          {%- endif -%}
        </h1>
        {%- if section.settings.intro != blank -%}
          <div class="gumis-page__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
        {%- if is_legal and section.settings.updated_label != blank -%}
          <p class="gumis-note">{{ 'gumis.legal.last_updated' | t: date: section.settings.updated_label }}</p>
        {%- endif -%}
      </header>

      {%- if section.settings.show_content -%}
        <div class="gumis-page__content rte{% if is_legal %} gumis-page__content--card{% endif %}">
          {%- if page.content != blank -%}
            {{ page.content }}
          {%- elsif is_legal -%}
            <p>
              <span class="gumis-placeholder-text">{{ 'gumis.general.to_complete' | t }}</span>
              {{ 'gumis.legal.placeholder' | t }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gumis Page",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The content comes from the page (Online Store > Pages)."
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Brand page"
        },
        {
          "value": "legal",
          "label": "Legal page (plain)"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = page title."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show the page content",
      "default": true
    },
    {
      "type": "text",
      "id": "updated_label",
      "label": "Last updated (legal pages)",
      "info": "e.g. 1 January 2027"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Gumis Page"
    }
  ]
}
{% endschema %}
