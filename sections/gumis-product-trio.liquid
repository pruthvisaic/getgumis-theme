{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.trio.heading' | t
  endif
  assign tiles = 'blush,peach,lilac' | split: ','
-%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<section
  id="{{ section.settings.anchor | default: 'gumis-products' | handleize }}"
  class="g-section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container">
    <div class="g-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ heading }}</h2>
      </div>
      <a href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}" class="g-text-link">
        {{- 'gumis.trio.view_all' | t -}}
      </a>
    </div>
    <ul class="g-grid g-grid--swipe" role="list">
      {%- for block in section.blocks -%}
        {%- assign i = forloop.index0 | modulo: 3 -%}
        <li {{ block.shopify_attributes }}>
          {%- render 'gumis-product-card',
            product: block.settings.product,
            accent: block.settings.accent,
            placeholder_title: block.settings.placeholder_title,
            badge: block.settings.badge,
            tile: tiles[i],
            primary: block.settings.primary,
            section_id: section.id
          -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Gumis Trio produits",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "info": "Vide = traduction par défaut." },
    { "type": "url", "id": "view_all_link", "label": "Lien « Voir tous les gummies »" },
    { "type": "text", "id": "anchor", "label": "Ancre (id)", "default": "gumis-products" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "limit": 6,
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "color", "id": "accent", "label": "Couleur d'accent", "info": "Couleur de l'étiquette du pot dessiné. Vide = métachamp custom.accent_color." },
        { "type": "text", "id": "placeholder_title", "label": "Nom affiché sans produit" },
        { "type": "text", "id": "badge", "label": "Badge (optionnel)", "info": "N'écrivez pas « best-seller » sans données de ventes réelles." },
        { "type": "checkbox", "id": "primary", "label": "Bouton plein (mise en avant)", "default": false },
        { "type": "paragraph", "content": "La phrase de bénéfice vient des métachamps du produit (custom.tagline, sinon 1er élément de custom.benefits)." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis Trio produits",
      "blocks": [
        { "type": "product", "settings": { "accent": "#3B0A2A", "placeholder_title": "Gumis Sommeil" } },
        { "type": "product", "settings": { "accent": "#D6246E", "placeholder_title": "Gumis Éclat", "primary": true } },
        { "type": "product", "settings": { "accent": "#FF8A3D", "placeholder_title": "Gumis Force" } }
      ]
    }
  ]
}
{% endschema %}
