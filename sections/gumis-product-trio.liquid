{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.trio.heading' | t
  endif
  assign tiles = 'blush,peach,lilac' | split: ','
  assign bottles = 'sleep,glow,power' | split: ','
-%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<section
  id="{{ section.settings.anchor | default: 'gumis-products' | handleize }}"
  class="g-section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container">
    <div class="g-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ heading }}</h2>
      </div>
      <a href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}" class="g-text-link">
        {{- 'gumis.trio.view_all' | t -}}
      </a>
    </div>
    <ul class="g-grid g-grid--swipe" role="list">
      {%- for block in section.blocks -%}
        {%- assign i = forloop.index0 | modulo: 3 -%}
        {%- assign bottle = block.settings.bottle | default: bottles[i] -%}
        <li {{ block.shopify_attributes }}>
          {%- render 'gumis-product-card',
            product: block.settings.product,
            accent: block.settings.accent,
            placeholder_title: block.settings.placeholder_title,
            badge: block.settings.badge,
            tile: tiles[i],
            bottle: bottle,
            primary: block.settings.primary,
            section_id: section.id
          -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Gumis Product trio",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = default translation."
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "\"See all gummies\" link"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor (id)",
      "default": "gumis-products"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "select",
          "id": "bottle",
          "label": "Bottle photo without product image",
          "options": [
            { "value": "", "label": "Automatic" },
            { "value": "sleep", "label": "Sleep" },
            { "value": "glow", "label": "Glow" },
            { "value": "power", "label": "Power" }
          ],
          "default": ""
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Accent colour",
          "info": "Card colour (tile tint and benefit text). Match the bottle: Sleep #3A5BD9, Glow #D6246E, Power #E8641A. Empty = custom.accent_color metafield."
        },
        {
          "type": "text",
          "id": "placeholder_title",
          "label": "Name shown when no product is selected"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (optional)",
          "info": "Don't write \"best-seller\" without real sales data."
        },
        {
          "type": "checkbox",
          "id": "primary",
          "label": "Solid button (highlight)",
          "default": false
        },
        {
          "type": "paragraph",
          "content": "The benefit line comes from the product metafields (custom.tagline, otherwise the first item of custom.benefits)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis Product trio",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "accent": "#3A5BD9",
            "placeholder_title": "Gumis Sleep"
          }
        },
        {
          "type": "product",
          "settings": {
            "accent": "#D6246E",
            "placeholder_title": "Gumis Glow",
            "primary": true
          }
        },
        {
          "type": "product",
          "settings": {
            "accent": "#E8641A",
            "placeholder_title": "Gumis Power"
          }
        }
      ]
    }
  ]
}
{% endschema %}
