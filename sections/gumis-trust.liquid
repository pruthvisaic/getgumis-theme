<section class="g-trust" aria-label="{{ 'gumis.trust.label' | t }}">
  <div class="g-container">
    <ul class="g-trust__list" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <span class="g-trust__icon">{%- render 'gumis-icon', icon: block.settings.icon -%}</span>
          <div><b>{{ block.settings.title }}</b>{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Gumis Trust card",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Trust card. Placed right below the hero, it overlaps its bottom edge."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            {
              "value": "truck",
              "label": "Shipping"
            },
            {
              "value": "lock",
              "label": "Payment"
            },
            {
              "value": "return",
              "label": "Returns"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "gummy",
              "label": "Gummy"
            },
            {
              "value": "jar",
              "label": "Jar"
            },
            {
              "value": "chat",
              "label": "Contact"
            }
          ]
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Heading",
          "default": "Free shipping"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "On orders over €[TO COMPLETE]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis Trust card",
      "blocks": [
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
