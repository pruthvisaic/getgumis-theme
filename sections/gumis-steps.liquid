{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.steps.heading' | t
  endif
  assign tiles = 'blush,peach,lilac' | split: ','
-%}
<section
  id="{{ section.settings.anchor | default: 'gumis-how' | handleize }}"
  class="g-section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container">
    <div class="g-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ heading }}</h2>
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="g-text-link">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    <ol class="g-steps" role="list">
      {%- for block in section.blocks -%}
        {%- assign i = forloop.index0 | modulo: 3 -%}
        <li class="g-step g-tile--{{ tiles[i] }}" {{ block.shopify_attributes }}>
          <span class="g-step__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <h3><span class="visually-hidden">{{ 'gumis.steps.step' | t: number: forloop.index }} : </span>{{ block.settings.title }}</h3>
          <div class="g-step__text">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Gumis Comment ça marche",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Mode d'emploi" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "info": "Vide = « Comment ça marche ? »" },
    { "type": "text", "id": "button_label", "label": "Lien — texte" },
    { "type": "url", "id": "button_link", "label": "Lien — destination" },
    { "type": "text", "id": "anchor", "label": "Ancre (id)", "default": "gumis-how" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "limit": 4,
      "settings": [
        { "type": "inline_richtext", "id": "title", "label": "Titre", "default": "Étape" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>[À COMPLÉTER]</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis Comment ça marche",
      "blocks": [
        { "type": "step", "settings": { "title": "Choisissez votre formule", "text": "<p>Sommeil, Éclat ou Force : prenez celle qui vous ressemble.</p>" } },
        { "type": "step", "settings": { "title": "Croquez vos gummies", "text": "<p>Chaque jour, à la dose indiquée sur le pot. Pas d'eau, pas de grimace.</p>" } },
        { "type": "step", "settings": { "title": "Gardez le rythme", "text": "<p>Un pot de 60 gummies vous accompagne [À COMPLÉTER] jours.</p>" } }
      ]
    }
  ]
}
{% endschema %}
