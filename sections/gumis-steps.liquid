{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'gumis.steps.heading' | t
  endif
  assign tiles = 'blush,peach,lilac' | split: ','
-%}
<section
  id="{{ section.settings.anchor | default: 'gumis-how' | handleize }}"
  class="g-section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="g-container">
    <div class="g-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ heading }}</h2>
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="g-text-link">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    <ol class="g-steps" role="list">
      {%- for block in section.blocks -%}
        {%- assign i = forloop.index0 | modulo: 3 -%}
        <li class="g-step g-tile--{{ tiles[i] }}" {{ block.shopify_attributes }}>
          <span class="g-step__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <h3><span class="visually-hidden">{{ 'gumis.steps.step' | t: number: forloop.index }} : </span>{{ block.settings.title }}</h3>
          <div class="g-step__text">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Gumis How it works",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How to take them"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = \"How does it work?\""
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link destination"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor (id)",
      "default": "gumis-how"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Heading",
          "default": "Step"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>[TO COMPLETE]</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumis How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Choose your formula",
            "text": "<p>Sleep, Glow or Power: pick the one that fits you.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Chew your gummies",
            "text": "<p>Every day, at the dose shown on the jar. No water, no grimace.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Keep it up",
            "text": "<p>A jar of 60 gummies lasts you [TO COMPLETE] days.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
