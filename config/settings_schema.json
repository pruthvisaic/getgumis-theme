  {
    "name": "Gumis — marque",
    "settings": [
      {
        "type": "header",
        "content": "Couleurs de marque"
      },
      {
        "type": "paragraph",
        "content": "Ces couleurs alimentent les formes décoratives, le logo, les cartes produit et les composants Gumis. Les palettes de sections se règlent dans « Couleurs »."
      },
      {
        "type": "color",
        "id": "gumis_ink",
        "label": "Ink (texte, boutons)",
        "default": "#2A0A1F"
      },
      {
        "type": "color",
        "id": "gumis_berry",
        "label": "Berry (principale)",
        "default": "#D6246E"
      },
      {
        "type": "color",
        "id": "gumis_plum",
        "label": "Plum (texte, sections sombres)",
        "default": "#3B0A2A"
      },
      {
        "type": "color",
        "id": "gumis_tangerine",
        "label": "Tangerine (accent)",
        "default": "#FF8A3D"
      },
      {
        "type": "color",
        "id": "gumis_bubblegum",
        "label": "Bubblegum (fonds doux)",
        "default": "#FFD3E2"
      },
      {
        "type": "color",
        "id": "gumis_cream",
        "label": "Cream (fond de page)",
        "default": "#FFF4EC"
      },
      {
        "type": "color",
        "id": "gumis_blush",
        "label": "Blush (blocs pastel)",
        "default": "#FBF0F3"
      },
      {
        "type": "color",
        "id": "gumis_peach",
        "label": "Peach (blocs pastel)",
        "default": "#FFF3EA"
      },
      {
        "type": "color",
        "id": "gumis_lilac",
        "label": "Lilac (blocs pastel)",
        "default": "#F4F0F8"
      },
      {
        "type": "header",
        "content": "Formes"
      },
      {
        "type": "range",
        "id": "gumis_radius",
        "label": "Arrondi des grands blocs",
        "min": 8,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "checkbox",
        "id": "gumis_show_blobs",
        "label": "Afficher les gummies décoratifs",
        "default": true
      },
      {
        "type": "header",
        "content": "Logo texte"
      },
      {
        "type": "paragraph",
        "content": "Sans image de logo, le thème affiche le logo « gumis » (Fredoka Bold, point du i en gummy orange)."
      },
      {
        "type": "color",
        "id": "gumis_logo_color",
        "label": "Couleur du logo",
        "default": "#D6246E"
      },
      {
        "type": "color",
        "id": "gumis_logo_dot_color",
        "label": "Couleur du point gummy",
        "default": "#FF8A3D"
      },
      {
        "type": "text",
        "id": "gumis_tagline",
        "label": "Signature (tagline)",
        "info": "Laisser vide pour utiliser la traduction par défaut : « Vos vitamines, en version gourmande. »"
      },
      {
        "type": "header",
        "content": "Produits"
      },
      {
        "type": "number",
        "id": "gumis_gummies_per_jar",
        "label": "Nombre de gummies par pot",
        "default": 60
      }
    ]
  },
