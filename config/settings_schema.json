  {
    "name": "Gumis: brand",
    "settings": [
      {
        "type": "header",
        "content": "Brand colours"
      },
      {
        "type": "paragraph",
        "content": "These colours drive the decorative shapes, the logo, product cards and Gumis components. Section palettes are set under \"Colors\"."
      },
      {
        "type": "color",
        "id": "gumis_ink",
        "label": "Ink (text, buttons)",
        "default": "#2A0A1F"
      },
      {
        "type": "color",
        "id": "gumis_berry",
        "label": "Berry (primary)",
        "default": "#D6246E"
      },
      {
        "type": "color",
        "id": "gumis_plum",
        "label": "Plum (text, dark sections)",
        "default": "#3B0A2A"
      },
      {
        "type": "color",
        "id": "gumis_tangerine",
        "label": "Tangerine (accent)",
        "default": "#FF8A3D"
      },
      {
        "type": "color",
        "id": "gumis_bubblegum",
        "label": "Bubblegum (soft backgrounds)",
        "default": "#FFD3E2"
      },
      {
        "type": "color",
        "id": "gumis_cream",
        "label": "Cream (page background)",
        "default": "#FFF4EC"
      },
      {
        "type": "color",
        "id": "gumis_blush",
        "label": "Blush (pastel blocks)",
        "default": "#FBF0F3"
      },
      {
        "type": "color",
        "id": "gumis_peach",
        "label": "Peach (pastel blocks)",
        "default": "#FFF3EA"
      },
      {
        "type": "color",
        "id": "gumis_lilac",
        "label": "Lilac (pastel blocks)",
        "default": "#F4F0F8"
      },
      {
        "type": "header",
        "content": "Shapes"
      },
      {
        "type": "range",
        "id": "gumis_radius",
        "label": "Corner radius of large blocks",
        "min": 8,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "checkbox",
        "id": "gumis_show_blobs",
        "label": "Show decorative gummies",
        "default": true
      },
      {
        "type": "header",
        "content": "Text logo"
      },
      {
        "type": "paragraph",
        "content": "Without a logo image, the theme shows the \"getgumis\" wordmark (Fredoka Bold, the dot of the i is an orange gummy)."
      },
      {
        "type": "color",
        "id": "gumis_logo_color",
        "label": "Logo colour",
        "default": "#3B0A2A"
      },
      {
        "type": "text",
        "id": "gumis_logo_prefix",
        "label": "Logo prefix",
        "default": "get",
        "info": "Shown before \"gumis\" in the wordmark (getgumis). Leave empty for \"gumis\" only."
      },
      {
        "type": "color",
        "id": "gumis_logo_prefix_color",
        "label": "Logo prefix colour",
        "default": "#D6246E",
        "info": "Colour of \"get\" in the wordmark."
      },
      {
        "type": "color",
        "id": "gumis_logo_dot_color",
        "label": "Gummy dot colour",
        "default": "#FF8A3D"
      },
      {
        "type": "text",
        "id": "gumis_tagline",
        "label": "Tagline",
        "info": "Leave empty to use the default translation: \"Your vitamins, made tasty.\""
      },
      {
        "type": "header",
        "content": "Products"
      },
      {
        "type": "number",
        "id": "gumis_gummies_per_jar",
        "label": "Gummies per jar",
        "default": 60
      }
    ]
  },
