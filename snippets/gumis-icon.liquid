{%- comment -%}
  Inline SVG stroke icons (24x24, currentColor). Decorative by default.
  Accepts:
  - icon {string} name
  - label {string} optional accessible label (makes the icon non-decorative)
  - class {string} optional extra class
  Usage: {% render 'gumis-icon', icon: 'check' %}
{%- endcomment -%}
<svg
  class="gumis-icon gumis-icon--{{ icon }}{% if class %} {{ class }}{% endif %}"
  viewBox="0 0 24 24"
  {% if label %}
    role="img" aria-label="{{ label | escape }}"
  {% else %}
    aria-hidden="true" focusable="false"
  {% endif %}
>
  {%- case icon -%}
    {%- when 'check' -%}
      <path d="M4.5 12.5l4.5 4.5 10.5-10.5"/>
    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="9.5"/><path d="M7.5 12.3l3 3 6-6.3"/>
    {%- when 'cross' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'cross-circle' -%}
      <circle cx="12" cy="12" r="9.5"/><path d="M9 9l6 6M15 9l-6 6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'arrow-right' -%}
      <path d="M4 12h15M13 6l6 6-6 6"/>
    {%- when 'moon' -%}
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/>
    {%- when 'sparkle' -%}
      <path d="M12 3c.7 4.2 2.8 6.3 7 7-4.2.7-6.3 2.8-7 7-.7-4.2-2.8-6.3-7-7 4.2-.7 6.3-2.8 7-7z"/><path d="M19 16.5c.3 1.5 1 2.2 2.5 2.5-1.5.3-2.2 1-2.5 2.5-.3-1.5-1-2.2-2.5-2.5 1.5-.3 2.2-1 2.5-2.5z"/>
    {%- when 'bolt' -%}
      <path d="M13 2.5L4.5 13.5H12l-1 8 8.5-11H12l1-8z"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19l7-7"/>
    {%- when 'jar' -%}
      <rect x="6" y="3" width="12" height="4" rx="1.5"/><path d="M7 7h10a1.5 1.5 0 0 1 1.5 1.5V19a2 2 0 0 1-2 2h-9a2 2 0 0 1-2-2V8.5A1.5 1.5 0 0 1 7 7z"/><path d="M8.5 12.5h7"/>
    {%- when 'gummy' -%}
      <path d="M8 7.5c0-2.5 1.8-4 4-4s4 1.5 4 4c1.8.4 3 1.8 3 3.8 0 1.6-.8 2.7-2 3.3l.8 4.4c.2 1.1-.6 1.8-1.6 1.5L12 19l-4.2 1.5c-1 .3-1.8-.4-1.6-1.5l.8-4.4c-1.2-.6-2-1.7-2-3.3 0-2 1.2-3.4 3-3.8z"/>
    {%- when 'calendar' -%}
      <rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
    {%- when 'smile' -%}
      <circle cx="12" cy="12" r="9.5"/><path d="M8.5 14.5c1.8 2 5.2 2 7 0"/><path d="M9 9.5h.01M15 9.5h.01"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="8" width="17" height="4.5" rx="1.2"/><path d="M5 12.5v7.5h14v-7.5M12 8v12"/><path d="M12 8c-1.5-3.5-5.5-3.5-5.5-1S10 8 12 8zM12 8c1.5-3.5 5.5-3.5 5.5-1S14 8 12 8z"/>
    {%- when 'mail' -%}
      <rect x="3" y="5.5" width="18" height="13" rx="3"/><path d="M3.5 7.5l8.5 6 8.5-6"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>
    {%- when 'shield' -%}
      <path d="M12 3l7.5 3v5.5c0 4.5-3.2 8-7.5 9.5-4.3-1.5-7.5-5-7.5-9.5V6z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9.5"/><path d="M12 7v5l3.5 2"/>
    {%- when 'drop' -%}
      <path d="M12 3.5s6.5 7 6.5 11a6.5 6.5 0 0 1-13 0c0-4 6.5-11 6.5-11z"/>
    {%- when 'cart' -%}
      <path d="M3 4h2.5l2.2 11h10.6l2-8H6.5"/><circle cx="9.5" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/>
    {%- when 'return' -%}
      <path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>
    {%- when 'chat' -%}
      <path d="M4 5.5h16v10.5H10l-4.5 3.5V16H4z"/>
    {%- when 'cookie' -%}
      <path d="M20.5 12.5A8.5 8.5 0 1 1 11.5 3.5a3 3 0 0 0 4 3.5 3 3 0 0 0 5 5.5z"/><path d="M8.5 10h.01M10 15h.01M15 14.5h.01"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9.5"/>
  {%- endcase -%}
</svg>
