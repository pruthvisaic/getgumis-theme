{% doc %}
  Renders the Gumis-specific blocks of the main product section.
  All product facts come from metafields (namespace "custom"), never from theme copy.

  @param {object} block - The section block.
  @param {product} product - The product.
  @param {string} product_form_id - Id of the product form.
{% enddoc %}
{%- liquid
  assign mf = product.metafields.custom
  assign accent = mf.accent_color.value
  if accent == blank or accent == 'rgba(0,0,0,0)'
    assign accent = settings.gumis_berry
  endif
-%}
{%- case block.type -%}
  {%- when 'gumis_tagline' -%}
    <div class="gumis-pdp-tagline" {{ block.shopify_attributes }}>
      {%- if mf.tagline.value != blank -%}
        <p class="gumis-pdp-tagline__text">{{ mf.tagline.value | escape }}</p>
      {%- elsif request.design_mode -%}
        <p class="gumis-pdp-tagline__text"><span class="gumis-placeholder-text">{{ 'gumis.pdp.missing_metafield' | t: key: 'custom.tagline' }}</span></p>
      {%- endif -%}
      <ul class="gumis-pdp-tagline__pills list-unstyled" role="list">
        {%- if block.settings.show_jar -%}
          <li class="g-pill">
            {%- render 'gumis-icon', icon: 'jar' -%}
            {{ 'gumis.product.jar_count' | t: count: settings.gumis_gummies_per_jar }}
          </li>
        {%- endif -%}
        {%- if block.settings.show_serving and mf.serving.value != blank -%}
          <li class="g-pill">
            {%- render 'gumis-icon', icon: 'gummy' -%}
            {{ mf.serving.value | escape }}
          </li>
        {%- endif -%}
      </ul>
    </div>

  {%- when 'gumis_quantity_breaks' -%}
    <div class="gumis-pdp-qb" {{ block.shopify_attributes }}>
      {%- render 'gumis-quantity-breaks',
        product: product,
        form_id: product_form_id,
        accent: accent,
        default_quantity: block.settings.default_quantity,
        legend: block.settings.legend
      -%}
    </div>
    <script src="{{ 'gumis-quantity-breaks.js' | asset_url }}" defer="defer"></script>

  {%- when 'gumis_benefits' -%}
    {%- assign benefits = mf.benefits.value -%}
    {%- if benefits != blank -%}
      <div class="gumis-pdp-benefits" style="--accent: {{ accent }};" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h2 class="g-label">{{ block.settings.heading }}</h2>
        {%- endif -%}
        <ul class="g-highlights" role="list">
          {%- for benefit in benefits -%}
            <li>{%- render 'gumis-icon', icon: 'check' -%}<span>{{ benefit | escape }}</span></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- elsif request.design_mode -%}
      <p {{ block.shopify_attributes }}>
        <span class="gumis-placeholder-text">{{ 'gumis.pdp.missing_metafield' | t: key: 'custom.benefits' }}</span>
      </p>
    {%- endif -%}

  {%- when 'gumis_info' -%}
    <div class="gumis-pdp-info g-accordion" {{ block.shopify_attributes }}>
      {%- comment -%} Ingrédients {%- endcomment -%}
      <details class="g-acc"{% if block.settings.open_first %} open{% endif %}>
        <summary>
          <h2 class="g-acc__title">{{ 'gumis.pdp.tab_ingredients' | t }}</h2>
        </summary>
        <div class="g-accordion__body rte">
          {%- if mf.ingredients != blank -%}
            {{ mf.ingredients | metafield_tag }}
          {%- else -%}
            <p><span class="gumis-placeholder-text">{{ 'gumis.general.to_complete' | t }}</span></p>
          {%- endif -%}
        </div>
      </details>

      {%- comment -%} Valeurs nutritionnelles {%- endcomment -%}
      {%- liquid
        assign nt = mf.nutrition_table.value
        assign rows = nt.rows | default: nt
        assign nt_serving = nt.serving | default: mf.serving.value
      -%}
      <details class="g-acc">
        <summary>
          <h2 class="g-acc__title">{{ 'gumis.pdp.tab_nutrition' | t }}</h2>
        </summary>
        <div class="g-accordion__body">
          {%- if rows != blank -%}
            <div class="gumis-nutrition">
              <table class="gumis-nutrition__table">
                <caption class="visually-hidden">{{ 'gumis.pdp.tab_nutrition' | t }}</caption>
                <thead>
                  <tr>
                    <th scope="col">{{ 'gumis.pdp.nutrition_label' | t }}</th>
                    <th scope="col">
                      {%- if nt_serving != blank -%}
                        {{ 'gumis.pdp.nutrition_per' | t: serving: nt_serving }}
                      {%- else -%}
                        {{ 'gumis.pdp.nutrition_per_serving' | t }}
                      {%- endif -%}
                    </th>
                    <th scope="col">{{ 'gumis.pdp.nutrition_nrv' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for row in rows -%}
                    <tr>
                      <th scope="row">{{ row.label | escape }}</th>
                      <td>{{ row.per_serving | escape }}</td>
                      <td>{{ row.percent_nrv | default: '–' | escape }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
              <p class="gumis-note">{{ 'gumis.pdp.nutrition_footnote' | t }}</p>
            </div>
          {%- else -%}
            <p><span class="gumis-placeholder-text">{{ 'gumis.general.to_complete' | t }}</span></p>
          {%- endif -%}
        </div>
      </details>

      {%- comment -%} Conseils d'utilisation {%- endcomment -%}
      <details class="g-acc">
        <summary>
          <h2 class="g-acc__title">{{ 'gumis.pdp.tab_how_to_use' | t }}</h2>
        </summary>
        <div class="g-accordion__body rte">
          {%- if mf.serving.value != blank -%}
            <p><strong>{{ 'gumis.pdp.daily_dose' | t }}</strong> {{ mf.serving.value | escape }}</p>
          {%- endif -%}
          {%- if mf.how_to_use != blank -%}
            {{ mf.how_to_use | metafield_tag }}
          {%- elsif mf.serving.value == blank -%}
            <p><span class="gumis-placeholder-text">{{ 'gumis.general.to_complete' | t }}</span></p>
          {%- endif -%}
        </div>
      </details>

      {%- comment -%}
        Précautions. The 3 mandatory food-supplement statements are ALWAYS rendered:
        any statement not already present in custom.warnings is appended from the locale file.
      {%- endcomment -%}
      {%- liquid
        assign warnings_text = ''
        if mf.warnings != blank
          assign warnings_text = mf.warnings | metafield_text | downcase
        endif
        assign statement_keys = 'gumis.compliance.dose,gumis.compliance.children,gumis.compliance.diet' | split: ','
        assign probes = 'gumis.compliance.dose_probe,gumis.compliance.children_probe,gumis.compliance.diet_probe' | split: ','
      -%}
      <details class="g-acc gumis-accordion--warnings"{% if block.settings.open_warnings %} open{% endif %}>
        <summary>
          <h2 class="g-acc__title">{{ 'gumis.pdp.tab_warnings' | t }}</h2>
        </summary>
        <div class="g-accordion__body rte">
          {%- if mf.warnings != blank -%}
            {{ mf.warnings | metafield_tag }}
          {%- endif -%}
          <ul class="gumis-mandatory">
            {%- for key in statement_keys -%}
              {%- assign probe = probes[forloop.index0] | t | downcase -%}
              {%- unless warnings_text contains probe -%}
                <li>{{ key | t }}</li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        </div>
      </details>
    </div>

  {%- when 'gumis_reassurance' -%}
    <ul class="g-mini-trust" role="list" {{ block.shopify_attributes }}>
      {%- for i in (1..4) -%}
        {%- liquid
          assign text_key = 'text_' | append: i
          assign icon_key = 'icon_' | append: i
          assign text = block.settings[text_key]
        -%}
        {%- if text != blank -%}
          <li>
            {%- render 'gumis-icon', icon: block.settings[icon_key] -%}
            <span>{{ text }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
{%- endcase -%}
