    "faq": {
      "type": "gumis-faq",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "question": "Combien de gummies par jour ?",
            "answer": "<p>Cela dépend de la formule : la dose journalière recommandée est indiquée sur chaque fiche produit et sur le pot. Ne la dépassez pas.</p>"
          }
        },
        "question-2": {
          "type": "question",
